// use prisma-next

enum ItemStatus {
  @@type("pg/text@1")
  active = "active"
  paused = "paused"
  traded = "traded"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  items     Item[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Item {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  condition   String
  image       String?
  city        String
  status      ItemStatus @default(active)
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}