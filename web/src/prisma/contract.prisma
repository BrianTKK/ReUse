// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  items     Item[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Item {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  condition   String
  image       String?
  city        String
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}